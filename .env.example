# Configuración de SIRAH.
# Copia este archivo a `.env` y completa lo que falte:
#
#   cp .env.example .env
#   chmod 600 .env
#
# `sirah setup` hace esto por ti. Nunca versiones `.env`: contiene secretos.
# Las variables de entorno del proceso tienen prioridad sobre este archivo.
# Los comentarios en la misma línea deben ir tras un espacio y fuera de comillas.

# =============================================================================
# 1. LLM — lo único obligatorio para conversar
# =============================================================================
# Cualquier proveedor compatible con OpenAI (/chat/completions y SSE).
# Por defecto: Groq Free con gpt-oss-20b.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_S=60
# gpt-oss-20b gasta parte del límite en razonamiento. Con 1024 y esfuerzo bajo,
# las respuestas normales caben completas.
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.6
# low, medium, high o vacío (vacío = no se envía el parámetro).
# Groq lo admite para gpt-oss-20b y gpt-oss-120b. Si tu proveedor lo rechaza,
# déjalo vacío.
LLM_REASONING_EFFORT=low

# =============================================================================
# 2. Persona y datos locales
# =============================================================================
# Temporal: ruta a una tarjeta de personaje. Vacío = la tarjeta `active` de
# config/sirah.toml (por defecto config/persona/sirah.json). Tiene prioridad
# sobre el TOML. La tarjeta y el modo de identidad se configuran ahí.
# Cada tarjeta tiene su propio historial en $XDG_DATA_HOME/sirah/history/.
SIRAH_PERSONA=

# Nombre del usuario. Vacío = el prompt no lo menciona. Es solo un dato.
USER_NAME=

# Directorio de historial y logs. Vacío = $XDG_DATA_HOME/sirah.
SIRAH_DATA_DIR=
MEMORY_MESSAGES=12
MEMORY_PERSIST=true

# =============================================================================
# 3. Ojos (ESP32 por USB serial) — opt-in
# =============================================================================
# Vacío = ojos apagados. Usa siempre /dev/serial/by-id/..., no /dev/ttyUSB0.
# Ejemplo: EYES_ADDRESS=serial:///dev/serial/by-id/usb-Silicon_Labs_CP2102...
EYES_ADDRESS=
EYES_BAUD=115200
EYES_HEARTBEAT_MS=1000
EYES_TARGET_HZ=15

# =============================================================================
# 4. Visión (cámara V4L2 + YuNet) — opt-in
# =============================================================================
VISION_ENABLED=false
VISION_CAMERA=/dev/video0
VISION_MODEL=models/face_detection_yunet_2023mar.onnx

# =============================================================================
# 5. Voz (Groq STT + Piper) — opt-in con `sirah voice`
# =============================================================================
# El audio del micrófono se envía a Groq para transcribirse y no se guarda en
# disco. Sin GROQ_API_KEY, `sirah voice` avisa y sigue por texto.
# Obligatoria solo si el proveedor del LLM no es Groq.
# Si LLM_BASE_URL es de Groq y esto queda vacío, se reutiliza LLM_API_KEY.
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=es
STT_TIMEOUT_S=30

# Ruta al modelo Piper y su .onnx.json. `sirah setup` puede descargarlos.
TTS_MODEL=models/voices/es_MX-claude-high.onnx

# Vacío = dispositivo por defecto de ALSA.
# Ejemplos: "plughw:CARD=Headset,DEV=0" o "default".
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
# Reproductor de audio. Vacío = autodetección: prueba aplay y, si se cuelga con
# PipeWire (fallo conocido), usa paplay o pw-play. Fíjalo para forzar uno.
# aplay recibe -q/-D; paplay --device; pw-play --target y lee WAV por stdin con "-".
AUDIO_PLAYER_COMMAND=
# VAD adaptativo: mide el suelo de ruido y separa voz y ruido con histéresis.
# El suelo se calibra al arrancar y tras un silencio largo (500 ms por defecto).
VAD_NOISE_CALIBRATION_MS=500
# inicio = max(suelo * 1.6, VAD_MIN_START_RMS); fin = max(suelo * 1.2, VAD_MIN_END_RMS).
VAD_START_MULTIPLE=1.6
VAD_END_MULTIPLE=1.2
VAD_MIN_START_RMS=1200
VAD_MIN_END_RMS=600
# Alias antiguo: si VAD_MIN_START_RMS está vacío, VAD_MIN_RMS hace de mínimo de inicio.
VAD_MIN_RMS=
VAD_AGGRESSIVENESS=2
VAD_PREBUFFER_MS=300
VAD_START_FRAMES=3
VAD_SILENCE_MS=400
VAD_MAX_TURN_MS=10000

# =============================================================================
# 6. Panel web — hito 7
# =============================================================================
# Por defecto solo escucha en localhost. Si PANEL_HOST no es loopback,
# PANEL_TOKEN es obligatorio (mínimo 16 caracteres).
PANEL_HOST=127.0.0.1
PANEL_PORT=8765
PANEL_TOKEN=

# =============================================================================
# 7. Logs
# =============================================================================
# DEBUG, INFO, WARNING o ERROR. Los trazas van al archivo, no a la consola.
LOG_LEVEL=INFO
